direction: right

title: {
  label: "List Fields — 8,192 token budget"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

prompt: "Prompt\n~700 tok (9%)" {
  shape: rectangle
  style.fill: "#bbf7d0"
  style.stroke: "#16a34a"
  style.font-size: 13
}

chunks: "30 small chunks\n30 x ~145 = ~4,350 tok (53%)" {
  shape: rectangle
  style.fill: "#4ade80"
  style.stroke: "#16a34a"
  style.font-size: 13
  style.bold: true
}

output: "Output\n~3,100 tok (38%)" {
  shape: rectangle
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  style.font-size: 13
}

prompt -> chunks {style.stroke: "#16a34a"}
chunks -> output {style.stroke: "#16a34a"}
