direction: down

sources: {
  label: Detection Sources
  style.font-size: 14
  grid-rows: 1

  s1: {label: Input Scan; style.font-size: 13}
  s2: {label: Base64 Scan; style.font-size: 13}
  s3: {label: Output Scan; style.font-size: 13}
}

record: {
  label: record_finding()
  style.font-size: 15
  style.bold: true
  style.fill: "#dbeafe"
  style.stroke: "#2563eb"
}

destinations: {
  label: Destinations
  style.font-size: 14
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  grid-rows: 1

  d1: {label: "Structured Log\n(metadata only)"; style.font-size: 12}
  d2: {label: "Guard Context\n(session count)"; style.font-size: 12}
  d3: {label: "Audit Trail\n(full detail)"; style.font-size: 12}
}

sources -> record
record -> destinations
