direction: down

data: "MedQA / USMLE\n2,000 train · 200 eval · 5-option MCQs" {
  shape: cylinder
  style.fill: "#dbeafe"
  style.stroke: "#2563eb"
  style.font-size: 14
}

train: "QLoRA Fine-tune on A100\nUnsloth · rank 16 · 3 epochs · 16 min" {
  shape: rectangle
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  style.font-size: 14
  style.bold: true
}

data -> train

adapter: "LoRA Adapter\n(safetensors · few MB)" {
  shape: stored_data
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  style.font-size: 13
}

train -> adapter

paths: "Two Deployment Paths" {
  grid-columns: 2
  grid-gap: 60
  style.fill: "#f8fafc"
  style.stroke: "#475569"
  style.font-size: 15
  style.bold: true

  hf: "Path A — HF + PEFT on GPU" {
    direction: down
    style.fill: "#ecfdf5"
    style.stroke: "#16a34a"
    style.font-size: 13

    a: "Load adapter directly\nover base weights\n(lossless)" {
      style.fill: "#dcfce7"
      style.stroke: "#16a34a"
      style.font-size: 12
    }
    b: "58.0% MedQA" {
      style.fill: "#dcfce7"
      style.stroke: "#16a34a"
      style.font-size: 13
      style.bold: true
    }

    a -> b
  }

  gguf: "Path B — GGUF export → Ollama" {
    direction: down
    style.fill: "#fef2f2"
    style.stroke: "#dc2626"
    style.font-size: 13

    c: "Merge adapter into base\nQuantize to GGUF\n(lossy)" {
      style.fill: "#fee2e2"
      style.stroke: "#dc2626"
      style.font-size: 12
    }
    d: "49.5% MedQA\n(== untuned base)" {
      style.fill: "#fee2e2"
      style.stroke: "#dc2626"
      style.font-size: 13
      style.bold: true
    }

    c -> d
  }
}

adapter -> paths
