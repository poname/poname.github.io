grid-columns: 5

tm: {
  label: "Template Method"
  style.font-size: 13
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  direction: down
  answer: {label: "Can user skip?\nNo"; style.font-size: 12; style.bold: true; style.fill: "#bbf7d0"; style.stroke: "#16a34a"}
}

strategy: {
  label: Strategy
  style.font-size: 13
  style.fill: "#fee2e2"
  style.stroke: "#dc2626"
  direction: down
  answer: {label: "Can pass\nno-op"; style.font-size: 12; style.fill: "#fecaca"; style.stroke: "#dc2626"}
}

chain: {
  label: "Chain of Resp."
  style.font-size: 13
  style.fill: "#fee2e2"
  style.stroke: "#dc2626"
  direction: down
  answer: {label: "Can forget\nhandler"; style.font-size: 12; style.fill: "#fecaca"; style.stroke: "#dc2626"}
}

decorator: {
  label: Decorator
  style.font-size: 13
  style.fill: "#fee2e2"
  style.stroke: "#dc2626"
  direction: down
  answer: {label: "Can skip\nwrapping"; style.font-size: 12; style.fill: "#fecaca"; style.stroke: "#dc2626"}
}

builder: {
  label: Builder
  style.font-size: 13
  style.fill: "#fee2e2"
  style.stroke: "#dc2626"
  direction: down
  answer: {label: "Can omit\nsteps"; style.font-size: 12; style.fill: "#fecaca"; style.stroke: "#dc2626"}
}
